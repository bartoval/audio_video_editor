{
  "name": "studio-api",
  "version": "2.0.0",
  "description": "Video/Audio editor API - Refactored with 3-layer architecture",
  "main": "server.js",
  "scripts": {
    "build": "cd ../studio && npm run build",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.5.3",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "valerio_bartolini",
  "license": "AGPL-3.0-or-later"
}
